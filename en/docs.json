                  "product-description/product-introduction/EnergyDistribution",
                  "product-description/product-introduction/API"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Gas Station",
            "pages": [
              "api-references/gas-apis/contact",
              "api-references/gas-apis/guide/gas-account-guide",
              {
                "group": "API Interface",
                "pages": [
                  "api-references/gas-apis/apis/description",
                  {
                    "group": "Tron Resource",
                    "pages": [
                      "api-references/gas-apis/apis/gas-balance",
                      "api-references/gas-apis/apis/gas-create-order",
                      "api-references/gas-apis/apis/gas-flash-open",
